    {
      "parameters": {
        "jsCode": "// Collect all memory strings\nconst memories = $input.all().map(item => item.json.memory);\n\n// Join them into a single block\nconst memoryBlock = memories.join('\\n');\n\n// Return as one item\nreturn [\n  {\n    json: {\n      memoryBlock\n    }\n  }\n];\n"
      },
