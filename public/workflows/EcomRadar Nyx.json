        "toolDescription": "Fetch public‑schema table definitions (table name + ordered column list) from the ecomradar Postgres database and output them as a newline‑separated string for use in AI prompts.",
        "operation": "executeQuery",
        "query": "SELECT\n    table_name,\n    string_agg(\n        column_name || ' ' || data_type,\n        ', '                       -- delimiter\n        ORDER BY ordinal_position  -- sort inside each aggregate\n    ) AS columns\nFROM   information_schema.columns\nWHERE  table_schema = 'public'\n  AND  table_name IN ('niche','subcategory','product')   -- adjust the list\nGROUP  BY table_name\nORDER  BY table_name;",
